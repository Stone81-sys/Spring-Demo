<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kexiang.MyBatisDemo.mapper.UserInfoXmlMapper">
    <resultMap id="MapperXml" type="com.kexiang.MyBatisDemo.entity.UserInfo">
        <result property="userName" column="user_name"></result>
        <result property="createTime" column="create_time"></result>
        <result property="updateTime" column="update_time"></result>
    </resultMap>
    <insert id="insertXmlUserInfo">
        insert into use_info(age) values (#{age})
    </insert>
    <insert id="insertXml1">
        insert into use_info(age,user_name
        <if test="gender!=null">
            ,gender
        </if>
        )
        values(#{age},#{userName}
        <if test="gender!=null">
            ,#{gender}
        </if>
        )
    </insert>


</mapper>

